# CareerHack Candidate Backend - Environment Variables
# Copy this file to .env and fill in your values

FLASK_ENV=development
PORT=5000
SECRET_KEY=your-secret-key-here
JWT_SECRET_KEY=your-jwt-secret-key-here
JWT_ACCESS_TOKEN_EXPIRES=3600
FRONTEND_URL=http://localhost:3000

# ===========================================
# DATABASE - SQLite (default for development)
# ===========================================
DATABASE_URL=sqlite:///candidate.db

# ===========================================
# DATABASE - Supabase PostgreSQL (production)
# ===========================================
# 1. Create project at https://supabase.com
# 2. Go to Settings > Database > Connection string > URI
# 3. Use port 6543 (PgBouncer) for serverless functions
# DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# ===========================================
# AI PROVIDERS (optional)
# ===========================================
# OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=...

# ===========================================
# AWS S3 (optional - for resume file storage)
# ===========================================
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# AWS_S3_BUCKET=careerhack-candidate-resumes
# AWS_REGION=ap-south-1

# ===========================================
# EMAIL (optional)
# ===========================================
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=...
# SMTP_PASSWORD=...
